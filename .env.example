# Copy to `.env` for local development and fill in local test values only.
# Never commit the populated .env file.
PORT=4000
POLYGON_AMOY_RPC_URL=
POLYGON_AMOY_CHAIN_ID=80002
CONTRACT_ADDRESS=
ISSUER_PRIVATE_KEY=
# Server-side Ed25519 signing keys; never expose the private key.
CREDENTIAL_SIGNING_PRIVATE_KEY=
CREDENTIAL_SIGNING_PUBLIC_KEY=
# Random local bearer token for issuer-only API routes.
ISSUER_API_TOKEN=
CREDENTIAL_STORE_PATH=./backend/data/credentials.json
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
